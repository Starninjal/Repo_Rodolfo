<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MinhaAgenda.Views.Controls.FuncionarioControl">
    <VerticalStackLayout Spacing="10" Margin="20,20,20,0">
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout Spacing="5">
                <Label Text="Nome " VerticalOptions="Center" WidthRequest="60"></Label>
                <Entry x:Name="entryName" Placeholder="Nome" VerticalOptions="Center">
                    <Entry.Behaviors>
                        <toolkit:TextValidationBehavior 
                         x:Name="nameValidator"
                         Flags="ValidateOnAttaching,ValidateOnValueChanged"
                         MinimumLength="3"
                     />
                    </Entry.Behaviors>
                </Entry>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout Spacing="5">
                <Label Text="Idade " VerticalOptions="Center" WidthRequest="60"></Label>
                <Entry x:Name="entryIdade" Placeholder="Idade" VerticalOptions="Center">
                    <Entry.Behaviors>
                        <toolkit:TextValidationBehavior
                  x:Name="idadeValidator"
                  Flags="ValidateOnAttaching,ValidateOnValueChanged"
                  RegexPattern="^[0-9]+$"/>
                    </Entry.Behaviors>
                </Entry>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout Spacing="5">
                <Label Text="Sexo " VerticalOptions="Center" WidthRequest="60"></Label>
                <Entry x:Name="entrySexo" Placeholder="Sexo" VerticalOptions="Center">
                    <Entry.Behaviors>
                        <toolkit:TextValidationBehavior 
                         x:Name="sexoValidator"
                         Flags="ValidateOnAttaching,ValidateOnValueChanged"
                         MinimumLength="3"/>
                    </Entry.Behaviors>
                </Entry>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout Spacing="5">
                <Label Text="Cargo " VerticalOptions="Center" WidthRequest="60"></Label>
                <Entry x:Name="entryCargo" Placeholder="Cargo" VerticalOptions="Center">
                    <Entry.Behaviors>
                        <toolkit:TextValidationBehavior 
                         x:Name="cargoValidator"
                         Flags="ValidateOnAttaching,ValidateOnValueChanged"
                         MinimumLength="3"/>
                    </Entry.Behaviors>
                </Entry>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout Spacing="5">
                <Label Text="Observação " VerticalOptions="Center" WidthRequest="60"></Label>
                <Entry x:Name="entryObservacao" Placeholder="Observação" VerticalOptions="Center">
                    <Entry.Behaviors>
                        <toolkit:TextValidationBehavior 
                 x:Name="observacaoValidator"
                 Flags="ValidateOnAttaching,ValidateOnValueChanged"
                 MinimumLength="3"/>
                    </Entry.Behaviors>
                </Entry>
            </HorizontalStackLayout>
        </Frame>
        <Button x:Name="btnSave" Text="Salvar" Clicked="btnSave_Clicked"></Button>
    </VerticalStackLayout>
</ContentView>
